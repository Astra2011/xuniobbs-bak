# 统一行尾为 LF，避免跨平台换行符污染 diff
* text=auto

# 源码类文件强制 LF
*.php text eol=lf
*.js text eol=lf
*.css text eol=lf
*.htm text eol=lf
*.html text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.json text eol=lf
*.conf text eol=lf

# 二进制文件不转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.svg text eol=lf
